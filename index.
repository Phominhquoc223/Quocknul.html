            lab: (parsed[mod.id] && typeof parsed[mod.id].lab === "string") ? parsed[mod.id].lab : mod.defaultLabUrl
          };
        }
        return result;
      } catch (err) {
        const fallback = {};
        for (const mod of COURSE_MODULES) {
          fallback[mod.id] = {
            slide: mod.defaultSlideUrl,
            lab: mod.defaultLabUrl
          };
        }
        return fallback;
      }
    }

    /**
     * Lấy danh sách ID các bài Lab đã hoàn thành
     */
    function getCompletedLabs() {
      try {
        const raw = localStorage.getItem(LAB_COMPLETED_KEY);
        const arr = raw ? JSON.parse(raw) : [];
        return Array.isArray(arr) ? arr.map(Number) : [];
      } catch (err) {
        return [];
      }
    }

    function toggleLabCompleted(moduleId) {
      const current = new Set(getCompletedLabs());
      if (current.has(moduleId)) {
        current.delete(moduleId);
        showToast(`Đã bỏ đánh dấu hoàn thành Lab ${moduleId}.`);
      } else {
        current.add(moduleId);
        showToast(`Đã đánh dấu hoàn thành Lab ${moduleId}!`);
      }
      try {
        localStorage.setItem(LAB_COMPLETED_KEY, JSON.stringify(Array.from(current)));
      } catch (err) {
        // Bỏ qua nếu trình duyệt chặn lưu trữ
      }
      renderLabWorkspace(activeLabId);
    }

    let currentDrawerMode = "slide"; // 'slide' hoặc 'lab'
    let activeDetailModuleId = 1;
    let activeLabId = 1;
    let toastTimer = null;

    function showToast(msg) {
      const box = document.getElementById("toastBox");
      const text = document.getElementById("toastMessage");
      if (!box || !text) return;
      text.textContent = msg;
      box.classList.remove("hidden");
      box.classList.add("flex");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => hideToast(), 4000);
    }

    function hideToast() {
      const box = document.getElementById("toastBox");
      if (!box) return;
      box.classList.add("hidden");
      box.classList.remove("flex");
    }

    function openModal(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove("hidden");
      el.classList.add("flex");
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.add("hidden");
      el.classList.remove("flex");
    }

