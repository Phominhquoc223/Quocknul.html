<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cây Đa Tri Thức — Tin Học &amp; Ứng Dụng AI (FPT Polytechnic)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Thiết lập font chữ Inter và ngăn tràn ngang trên mọi thiết bị */
    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      background: linear-gradient(180deg, #dff3ea 0%, #f3faf6 52%, #e4f2e7 100%);
      color: #132a1e;
    }

    /* Chuyển động nhẹ nhàng cho tán lá và các nút nhánh cây đa */
    @keyframes gentleFloat {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-5px);
      }
    }

    @keyframes swayLeaf {
      0%, 100% {
        transform: rotate(-0.8deg);
      }
      50% {
        transform: rotate(0.8deg);
      }
    }

    .branch-float {
      animation: gentleFloat 4.2s ease-in-out infinite;
    }

    .branch-float-delayed {
      animation: gentleFloat 4.8s ease-in-out 1.1s infinite;
    }

    .branch-float-slow {
      animation: gentleFloat 5.2s ease-in-out 2s infinite;
    }

    .canopy-sway {
      transform-origin: 600px 260px;
      animation: swayLeaf 8s ease-in-out infinite;
    }

    .branch-btn {
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.25s ease,
                  background-color 0.25s ease,
                  border-color 0.25s ease;
    }

    .branch-btn:hover,
    .branch-btn:focus-visible {
      transform: scale(1.05) translateY(-2px);
      box-shadow: 0 14px 32px -6px rgba(16, 185, 129, 0.42),
                  0 0 0 4px rgba(16, 185, 129, 0.18);
      outline: none;
    }

    /* Tùy chỉnh thanh cuộn cho các modal */
    .custom-scroll::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }

    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 9999px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
      background: #94a3b8;
      border-radius: 9999px;
    }

    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #64748b;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <!-- Thanh điều hướng phía trên -->
  <header class="sticky top-0 z-30 w-full bg-white/90 backdrop-blur-md border-b border-emerald-900/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-emerald-700 text-white font-bold shadow-sm shrink-0">
          🌳
        </span>
        <div class="min-w-0">
      <!-- Thanh điều hướng trên cùng gọn gàng, hỗ trợ mở nhanh các nhánh -->
      <nav class="flex flex-wrap items-center gap-1.5 sm:gap-2" aria-label="Điều hướng nhanh">
        <button
          type="button"
          onclick="openModuleDrawer('slide')"
          class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-700 hover:bg-emerald-800 text-white shadow-sm transition cursor-pointer"
        >
          📘 Slide (8)
        </button>
        <button
          type="button"
          onclick="openLabWorkspaceModal(0)"
          class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold bg-amber-600 hover:bg-amber-700 text-white shadow-sm transition cursor-pointer"
        >
          🧪 Bài tập Lab (1–8)
        </button>
        <button
          type="button"
          onclick="openReferencesModal()"
          class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold bg-sky-700 hover:bg-sky-800 text-white shadow-sm transition cursor-pointer"
        >
          🔗 Tài liệu
        </button>
        <button
          type="button"
          onclick="openRecovery404Modal('Kiểm tra cấu hình & khắc phục lỗi 404')"
          class="px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-200 transition cursor-pointer"
          title="Hướng dẫn xử lý lỗi 404 và kiểm tra đường dẫn"
        >
          🛠️ Fix 404
        </button>
      </nav>
    </div>
  </header>

  <!-- Nội dung chính -->
  <main class="relative flex-1 w-full max-w-7xl mx-auto px-2 sm:px-6 py-4 sm:py-6 flex flex-col items-center justify-center">
    <!-- Sân khấu Cây Đa Nghệ Thuật với 3 nhánh tương tác -->
    <div class="relative w-full rounded-3xl overflow-hidden shadow-xl border border-emerald-900/10 bg-gradient-to-b from-[#d8f1e6] via-[#eef9f2] to-[#dceee0]">
      <svg
        viewBox="0 0 1200 760"
        class="w-full h-auto min-h-[450px] sm:min-h-[550px] md:min-h-[630px] block select-none"
        role="img"
        aria-label="Minh họa nghệ thuật cây đa cổ thụ với các nhánh Slide và ghi chú bài học, Bài tập Lab đã giải và Tài liệu tham khảo"
      >
        <defs>
          <radialGradient id="sunGlow" cx="50%" cy="22%" r="55%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.88" />
            <stop offset="55%" stop-color="#d1fae5" stop-opacity="0.38" />
            <stop offset="100%" stop-color="#a7f3d0" stop-opacity="0" />
          </radialGradient>

          <linearGradient id="barkGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#4a3222" />
            <stop offset="45%" stop-color="#6b4832" />
            <stop offset="100%" stop-color="#3c2618" />
          </linearGradient>

          <linearGradient id="canopyDark" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#15803d" />
            <stop offset="100%" stop-color="#14532d" />
          </linearGradient>

          <linearGradient id="canopyMid" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#22c55e" />
            <stop offset="100%" stop-color="#15803d" />
          </linearGradient>

          <linearGradient id="canopyLight" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#4ade80" />
            <stop offset="100%" stop-color="#16a34a" />
          </linearGradient>

          <linearGradient id="groundGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#86efac" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#4ade80" stop-opacity="0.78" />
          </linearGradient>
        </defs>

        <rect x="0" y="0" width="1200" height="760" fill="url(#sunGlow)" />

        <!-- Mây trang trí -->
        <g fill="#ffffff" opacity="0.72">
          <ellipse cx="185" cy="112" rx="68" ry="22" />
          <ellipse cx="220" cy="102" rx="45" ry="20" />
          <ellipse cx="1010" cy="126" rx="74" ry="24" />
          <ellipse cx="972" cy="116" rx="48" ry="20" />
        </g>

        <!-- Thảm cỏ -->
        <path d="M0,655 Q300,625 600,650 T1200,645 L1200,760 L0,760 Z" fill="url(#groundGrad)" />
      <!-- 2. Nhánh LAB (bên phải trên) -->
      <div class="branch-float-delayed absolute top-[24%] sm:top-[27%] right-[5%] sm:right-[11%] md:right-[15%] z-10">
        <button
          type="button"
          onclick="openLabWorkspaceModal(0)"
          class="branch-btn cursor-pointer group flex items-center gap-3 px-4 py-3 sm:px-5 sm:py-3.5 rounded-2xl bg-white/95 hover:bg-amber-50 border-2 border-amber-600 shadow-lg text-left max-w-[230px] sm:max-w-[270px]"
        >
          <span class="w-11 h-11 rounded-xl bg-amber-600 text-white flex items-center justify-center text-xl font-bold shrink-0 shadow-sm group-hover:scale-105 transition">
            🧪
          </span>
          <div class="min-w-0">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-amber-700">
              Nhánh Thực Hành
            </span>
            <span class="block text-base sm:text-lg font-extrabold text-amber-950 leading-tight">
              BÀI TẬP LAB
            </span>
            <span class="block text-xs text-slate-600 truncate">
              Xem ngay Lab 1–8 &amp; lời giải
            </span>
          </div>
        </button>
      </div>
<!-- ... existing ... -->
      <!-- Modal chi tiết từng bài (Nội dung tóm tắt + Ghi chú bài học + Slide + Lab + Lời giải) -->
      <div
        id="detailModal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/65 backdrop-blur-xs p-3 sm:p-6"
        role="dialog"
        aria-modal="true"
        aria-labelledby="detailTitle"
      >
        <div class="bg-white w-full max-w-4xl max-h-[92vh] rounded-3xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
          <div class="px-5 py-4 bg-slate-900 text-white flex items-start justify-between gap-3">
            <div class="min-w-0">
              <span id="detailBadge" class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 mb-1"></span>
              <h3 id="detailTitle" class="text-lg sm:text-xl font-extrabold leading-snug"></h3>
            </div>
            <button
              type="button"
              onclick="closeModal('detailModal')"
              aria-label="Đóng chi tiết bài học"
              class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold flex items-center justify-center transition cursor-pointer shrink-0"
            >
              ✕
            </button>
          </div>

          <div id="detailBody" class="p-5 sm:p-6 overflow-y-auto custom-scroll space-y-5 flex-1">
            <!-- Nội dung chi tiết bài học render bằng JS -->
          </div>

          <div class="px-5 py-3.5 bg-slate-100 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2">
            <button
              type="button"
              onclick="closeModal('detailModal')"
              class="px-4 py-2 rounded-xl text-sm font-semibold bg-white hover:bg-slate-200 text-slate-800 border border-slate-300 transition cursor-pointer"
            >
              ← Quay lại
            </button>
            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                id="detailOpenLabBtn"
                class="px-4 py-2 rounded-xl text-sm font-bold bg-amber-600 hover:bg-amber-700 text-white transition cursor-pointer"
              >
                🧪 Mở trình xem Lab &amp; Lời giải
              </button>
              <button
                type="button"
                onclick="openPathConfigModal()"
                class="px-4 py-2 rounded-xl text-sm font-semibold bg-slate-800 hover:bg-slate-900 text-white transition cursor-pointer"
              >
                ⚙️ Cấu hình URL
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal Trình Xem Bài Tập Lab Tương Tác (Lọc Lab 1..8, Lời giải chi tiết, Sao chép, Đánh dấu hoàn thành) -->
      <div
        id="labWorkspaceModal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 backdrop-blur-xs p-2 sm:p-5"
        role="dialog"
        aria-modal="true"
        aria-labelledby="labWorkspaceTitle"
      >
        <div class="bg-white w-full max-w-5xl max-h-[93vh] rounded-3xl shadow-2xl border border-amber-900/15 flex flex-col overflow-hidden">
          <div class="px-5 py-4 bg-gradient-to-r from-amber-700 via-amber-600 to-orange-600 text-white flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-wider font-semibold text-amber-100">
                Trình Xem Bài Tập Lab Tương Tác • Không Phụ Thuộc File Dễ 404
              </p>
              <h3 id="labWorkspaceTitle" class="text-lg sm:text-xl font-extrabold">
                Phòng Thực Hành Lab 1 – Lab 8 &amp; Lời Giải Chi Tiết
              </h3>
            </div>
            <div class="flex items-center gap-2">
              <span
                id="labProgressPill"
                class="px-3 py-1 rounded-full text-xs font-bold bg-white/20 text-white border border-white/30"
              >
                0/8 hoàn thành
              </span>
              <button
                type="button"
                onclick="closeModal('labWorkspaceModal')"
                aria-label="Đóng trình xem bài tập Lab"
                class="w-10 h-10 rounded-xl bg-white/15 hover:bg-white/25 text-white font-bold flex items-center justify-center transition cursor-pointer shrink-0"
              >
                ✕
              </button>
            </div>
          </div>

          <!-- Bộ lọc Lab 1..Lab 8 -->
          <div class="px-4 sm:px-6 py-3 bg-amber-50/80 border-b border-amber-200/80 flex items-center gap-1.5 overflow-x-auto custom-scroll" id="labFilterBar">
            <!-- Các nút lọc Lab 1..8 render bằng JS -->
          </div>

          <!-- Nội dung chi tiết bài Lab đang chọn -->
          <div id="labWorkspaceBody" class="p-4 sm:p-6 overflow-y-auto custom-scroll space-y-5 flex-1 bg-slate-50">
            <!-- Render bằng JS -->
          </div>
        </div>
      </div>

      <!-- Modal Dự Phòng Thông Minh & Bảng Kiểm Tra Lỗi 404 -->
      <div
        id="recovery404Modal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 backdrop-blur-xs p-3 sm:p-6"
        role="dialog"
        aria-modal="true"
        aria-labelledby="recovery404Title"
      >
        <div class="bg-white w-full max-w-3xl max-h-[92vh] rounded-3xl shadow-2xl border border-rose-200 flex flex-col overflow-hidden">
          <div class="px-5 py-4 bg-rose-800 text-white flex items-center justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-wider font-semibold text-rose-200">
                Chế Độ Dự Phòng Thông Minh &amp; Chẩn Đoán Đường Dẫn
              </p>
              <h3 id="recovery404Title" class="text-lg sm:text-xl font-extrabold">
                Khắc Phục Lỗi 404 &amp; Mở Nhanh Nội Dung Thay Thế
              </h3>
            </div>
            <button
              type="button"
              onclick="closeModal('recovery404Modal')"
              aria-label="Đóng cửa sổ khắc phục 404"
              class="w-10 h-10 rounded-xl bg-white/15 hover:bg-white/25 text-white font-bold flex items-center justify-center transition cursor-pointer shrink-0"
            >
              ✕
            </button>
          </div>

          <div id="recovery404Body" class="p-5 sm:p-6 overflow-y-auto custom-scroll space-y-5 flex-1">
            <!-- Render bằng JS -->
          </div>

          <div class="px-5 py-3.5 bg-slate-100 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2">
            <button
              type="button"
              onclick="returnToHomeSafe()"
              class="px-4 py-2 rounded-xl text-sm font-bold bg-emerald-700 hover:bg-emerald-800 text-white transition cursor-pointer"
            >
              🏠 Quay về trang chủ
            </button>
            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                onclick="closeModal('recovery404Modal'); openLabWorkspaceModal(0);"
                class="px-4 py-2 rounded-xl text-sm font-bold bg-amber-600 hover:bg-amber-700 text-white transition cursor-pointer"
              >
                🧪 Mở nhanh Bài tập Lab
              </button>
              <button
                type="button"
                onclick="closeModal('recovery404Modal')"
                class="px-4 py-2 rounded-xl text-sm font-semibold bg-white hover:bg-slate-200 text-slate-800 border border-slate-300 transition cursor-pointer"
              >
                Đóng
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lưới 8 chủ đề bài học -->
    <section aria-label="Danh sách 8 chủ đề bài học" class="w-full mt-6">
      <div class="mb-3 px-1">
        <h2 class="text-lg sm:text-xl font-bold text-emerald-950">
          8 Chủ Đề Slide, Ghi Chú Bài Học &amp; Bài Tập Lab Đã Hoàn Thiện
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Bấm vào từng bài để mở <strong>Slide &amp; Ghi chú bài học</strong> hoặc <strong>Bài tập Lab đã làm xong</strong>.
        </p>
      </div>

      <div id="topicsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        <!-- Render 8 thẻ chủ đề bằng JavaScript -->
      </div>
    </section>
  </main>

  <!-- Modal danh sách 8 bài theo nhánh SLIDE hoặc LAB -->
  <div
    id="drawerModal"
    class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-950/60 backdrop-blur-xs p-3 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="drawerTitle"
  >
    <div class="bg-white w-full max-w-4xl max-h-[90vh] rounded-3xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
      <div id="drawerHeader" class="px-5 py-4 bg-emerald-800 text-white flex items-center justify-between gap-3">
        <div>
          <p id="drawerSubtitle" class="text-xs uppercase tracking-wider font-semibold text-emerald-200"></p>
          <h3 id="drawerTitle" class="text-lg sm:text-xl font-extrabold"></h3>
        </div>
        <button
          type="button"
          onclick="closeModal('drawerModal')"
          aria-label="Đóng cửa sổ"
          class="w-10 h-10 rounded-xl bg-white/15 hover:bg-white/25 text-white font-bold flex items-center justify-center transition cursor-pointer shrink-0"
        >
          ✕
        </button>
      </div>

      <div id="drawerBody" class="p-4 sm:p-6 overflow-y-auto custom-scroll space-y-3.5 flex-1 bg-slate-50">
        <!-- Render danh sách bài bằng JavaScript -->
      </div>
    </div>
  </div>

  <!-- Modal chi tiết từng bài: Tab Slide & Ghi chú bài học / Tab Bài tập Lab đã làm xong -->
  <div
    id="detailModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/65 backdrop-blur-xs p-3 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="detailTitle"
  >
    <div class="bg-white w-full max-w-4xl max-h-[92vh] rounded-3xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
      <div class="px-5 py-4 bg-slate-900 text-white flex items-start justify-between gap-3">
        <div class="min-w-0">
          <span id="detailBadge" class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 mb-1"></span>
          <h3 id="detailTitle" class="text-lg sm:text-xl font-extrabold leading-snug"></h3>
        </div>
        <button
          type="button"
          onclick="closeModal('detailModal')"
          aria-label="Đóng chi tiết bài học"
          class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold flex items-center justify-center transition cursor-pointer shrink-0"
        >
          ✕
        </button>
      </div>

      <!-- Thanh chuyển đổi nhanh giữa Slide & Ghi chú bài học và Bài tập Lab đã làm -->
      <div class="px-5 pt-3.5 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="tabSlideBtn"
            onclick="switchDetailTab('slide')"
            class="px-4 py-2 rounded-t-xl text-xs sm:text-sm font-bold border-b-2 transition cursor-pointer"
          >
            📘 Slide &amp; Ghi chú bài học
          </button>
          <button
            type="button"
            id="tabLabBtn"
            onclick="switchDetailTab('lab')"
            class="px-4 py-2 rounded-t-xl text-xs sm:text-sm font-bold border-b-2 transition cursor-pointer"
          >
            🧪 Bài tập Lab đã làm xong
          </button>
        </div>
        <div id="detailLabCheckWrap" class="pb-2">
          <!-- Nút đánh dấu hoàn thành Lab render bằng JS -->
        </div>
      </div>

      <div id="detailBody" class="p-5 sm:p-6 overflow-y-auto custom-scroll space-y-5 flex-1">
        <!-- Nội dung tab render bằng JS -->
      </div>

      <div class="px-5 py-3.5 bg-slate-100 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="navigateDetailModule(-1)"
            class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white hover:bg-slate-200 text-slate-800 border border-slate-300 transition cursor-pointer"
          >
            ← Bài trước
          </button>
          <button
            type="button"
            onclick="navigateDetailModule(1)"
            class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white hover:bg-slate-200 text-slate-800 border border-slate-300 transition cursor-pointer"
          >
            Bài tiếp →
          </button>
        </div>

        <button
          type="button"
          onclick="openPathConfigModal()"
          class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-900 text-white transition cursor-pointer"
        >
          ⚙️ Sửa đường dẫn file bài này
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Tài Liệu Tham Khảo (bao gồm Thông tư 02/2025/TT-BGDĐT & TCVN 11930:2017) -->
