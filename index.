              </button>
            </div>
          </div>
        </div>
      `;
    }

    /**
     * Kiểm tra an toàn URL ngoài (chỉ cho phép http:// hoặc https:// hoặc các file định dạng an toàn không dẫn tới lỗi 404 vô nghĩa).
     * Nếu chưa cấu hình URL ngoài, mở trực tiếp trình xem tích hợp thay vì mở đường dẫn cục bộ gây 404.
     */
    function launchAttachment(moduleId, kind) {
      const paths = getFilePaths();
      const targetUrl = (kind === "lab" ? paths[moduleId].lab : paths[moduleId].slide || "").trim();

      if (!targetUrl) {
        if (kind === "lab") {
          closeModal("drawerModal");
          closeModal("detailModal");
          openLabWorkspaceModal(moduleId);
        } else {
          closeModal("drawerModal");
          openModuleDetail(moduleId, "slide");
        }
        return;
      }

      const isHttpUrl = /^https?:\/\//i.test(targetUrl);
      if (!isHttpUrl) {
        openRecovery404Modal(
          `Đường dẫn "${targetUrl}" không phải liên kết http(s) hợp lệ và dễ gây lỗi 404 trên máy chủ/sandbox.`
        );
        return;
      }

      try {
        const win = window.open(targetUrl, "_blank", "noopener,noreferrer");
        if (win) {
          showToast("Đã mở liên kết tài liệu ở tab mới.");
        } else {
          openRecovery404Modal("Trình duyệt đã chặn cửa sổ bật lên (popup) hoặc liên kết chưa truy cập được.");
        }
      } catch (err) {
        openRecovery404Modal("Không thể mở liên kết ngoài do lỗi trình duyệt hoặc đường dẫn.");
      }
    }

    /**
     * Mở modal dự phòng thông minh & bảng kiểm tra lỗi 404 thường gặp
     */
    function openRecovery404Modal(reasonText = "") {
      const body = document.getElementById("recovery404Body");
      if (!body) return;

      const checklist = [
        {
          title: "1. Đường dẫn tương đối sai khi deploy hoặc mở trong sandbox",
          detail:
            "Khi chạy file HTML đơn lẻ trên server tĩnh, GitHub Pages hoặc khung xem trước, các liên kết trỏ tới file rời (như Lab1.pdf, Slide1.pdf) chưa tải lên sẽ trả về HTTP 404. Hãy dùng trình xem Lab & Ghi chú tích hợp sẵn hoặc nhập URL https:// đầy đủ."
        },
        {
          title: "2. Phân biệt chữ HOA / chữ thường trên Linux & GitHub Pages",
          detail:
            "Hệ thống tệp trên Linux/GitHub Pages phân biệt hoa-thường (ví dụ Lab1.html khác lab1.html). Luôn dùng chữ thường thống nhất cho tên tệp và thư mục."
        },
        {
          title: "3. Dùng đường dẫn tuyệt đối bắt đầu bằng '/' thay vì './' hoặc tương đối",
          detail:
            "Trên các trang đặt trong thư mục con (ví dụ /mon-tin-hoc/), đường dẫn bắt đầu bằng /assets/... sẽ trỏ về thư mục gốc tên miền và gây 404. Hãy ưu tiên đường dẫn tương đối ./ hoặc URL https:// hoàn chỉnh."
        },
        {
          title: "4. Thiếu trang dự phòng 404.html khi người dùng gõ sai URL",
          detail:
            "Nếu lưu trữ tĩnh trên GitHub Pages/Netlify/Vercel, nên đặt sẵn tệp 404.html điều hướng về trang chính để tránh trang lỗi mặc định của máy chủ."
        }
      ];

      body.innerHTML = `
        <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 space-y-1.5">
          <p class="text-xs font-bold uppercase tracking-wider text-rose-700">
            Thông báo dự phòng (Chống kẹt màn hình 404)
          </p>
          <p class="text-sm font-semibold text-rose-950">
            ${escapeHtml(reasonText || "Nếu bạn vừa gặp lỗi 404 hoặc không mở được bài tập, hãy dùng các nút bên dưới để tiếp tục học tập ngay lập tức.")}
          </p>
        </div>

        <div class="space-y-3">
          <h4 class="text-sm font-extrabold text-slate-900">
            Bảng kiểm tra 4 nguyên nhân gây lỗi 404 thường gặp
          </h4>
          ${checklist
            .map(
              (item) => `
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-3.5 space-y-1">
                <p class="text-xs sm:text-sm font-bold text-slate-900">${escapeHtml(item.title)}</p>
                <p class="text-xs text-slate-600 leading-relaxed">${escapeHtml(item.detail)}</p>
              </div>
            `
            )
            .join("")}
        </div>
      `;

      openModal("recovery404Modal");
    }

    /**
     * Quay về trang chủ an toàn, đóng mọi modal đang mở
     */
    function returnToHomeSafe() {
      ["detailModal", "configModal", "drawerModal", "referencesModal", "labWorkspaceModal", "recovery404Modal"].forEach(
        (id) => closeModal(id)
      );
      window.scrollTo({ top: 0, behavior: "smooth" });
      showToast("Đã quay về trang chủ Cây Đa Tri Thức.");
    }

    /**
     * Sao chép một khối văn bản/lời giải vào clipboard
     */
    function copyTextBlock(text, successMsg = "Đã sao chép nội dung.") {
      try {
        const tempArea = document.createElement("textarea");
        tempArea.value = String(text ?? "");
        tempArea.setAttribute("readonly", "");
        tempArea.style.position = "fixed";
        tempArea.style.left = "-9999px";
        document.body.appendChild(tempArea);
        tempArea.select();
        document.execCommand("copy");
        document.body.removeChild(tempArea);
        showToast(successMsg);
      } catch (err) {
        showToast("Không thể sao chép tự động trên trình duyệt này.");
      }
    }

    /**
     * Lưu cấu hình URL ngoài vào localStorage (chỉ chấp nhận URL http/https hoặc chuỗi rỗng để tránh lỗi 404)
     */
    function saveFilePaths() {
      const inputs = document.querySelectorAll("#configInputs input[data-module-id]");
      const nextPaths = {};
      let hadInvalidWarning = false;

      for (const mod of COURSE_MODULES) {
        nextPaths[mod.id] = {
          slide: mod.defaultSlideUrl,
          lab: mod.defaultLabUrl
        };
      }

      inputs.forEach((inp) => {
        const id = Number(inp.getAttribute("data-module-id"));
        const kind = inp.getAttribute("data-kind");
        const val = inp.value.trim();
        if (nextPaths[id] && (kind === "slide" || kind === "lab")) {
          if (!val || /^https?:\/\//i.test(val)) {
            nextPaths[id][kind] = val;
          } else {
            nextPaths[id][kind] = "";
            hadInvalidWarning = true;
          }
        }
      });

      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(nextPaths));
      } catch (err) {
        // Bỏ qua nếu trình duyệt chặn lưu trữ
      }

      closeModal("configModal");
      renderTopicsGrid();

      if (hadInvalidWarning) {
        showToast("Đã bỏ qua đường dẫn không bắt đầu bằng http(s):// để tránh lỗi 404; giữ chế độ xem tích hợp.");
      } else {
        showToast("Đã lưu cấu hình URL thành công.");
      }

      const drawer = document.getElementById("drawerModal");
      if (drawer && !drawer.classList.contains("hidden")) {
        openModuleDrawer(currentDrawerMode);
      }
      const detail = document.getElementById("detailModal");
      if (detail && !detail.classList.contains("hidden")) {
        openModuleDetail(activeDetailModuleId, currentDrawerMode);
      }
    }

    /**
     * Hỗ trợ đóng modal bằng phím Escape hoặc bấm ra ngoài vùng nội dung
     */
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        ["detailModal", "configModal", "drawerModal", "referencesModal", "labWorkspaceModal", "recovery404Modal"].forEach(
          (id) => closeModal(id)
        );
      }
    });

    ["drawerModal", "detailModal", "referencesModal", "configModal", "labWorkspaceModal", "recovery404Modal"].forEach(
      (modalId) => {
        const el = document.getElementById(modalId);
        if (el) {
          el.addEventListener("click", (event) => {
            if (event.target === el) {
              closeModal(modalId);
            }
          });
        }
      }
    );
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              ${escapeHtml(ref.note)}
            </p>
            <p class="text-[11px] font-mono text-sky-700 break-all pt-1">
              ${escapeHtml(ref.url)}
            </p>
          </div>

          <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
            <a
              href="${escapeAttr(ref.url)}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-sky-700 hover:bg-sky-800 text-white transition"
            >
              Mở liên kết ↗
            </a>
            <button
              type="button"
              onclick="copyLink('${escapeAttr(ref.url)}')"
              class="px-3 py-2 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer"
            >
              Sao chép link
            </button>
          </div>
        </div>
      `).join("");

      openModal("referencesModal");
    }

    function copyLink(url) {
      try {
        const input = document.createElement("input");
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        document.body.removeChild(input);
        showToast("Đã sao chép đường dẫn tài liệu tham khảo.");
      } catch (e) {
        showToast("Không thể tự động sao chép liên kết.");
      }
    }

    /**
     * Cấu hình đường dẫn file Slide & Lab
     */
    function openPathConfigModal() {
      const container = document.getElementById("configInputs");
      if (!container) return;
      const paths = getFilePaths();

      container.innerHTML = COURSE_MODULES.map((mod) => `
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-3.5 space-y-2.5">
          <div class="text-xs sm:text-sm font-bold text-slate-900">
            ${mod.icon} ${escapeHtml(mod.code)}: ${escapeHtml(mod.title)}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <label class="block text-[11px] font-semibold text-emerald-800 mb-1">
                Đường dẫn / tên file Slide
              </label>
              <input
                type="text"
                data-module-id="${mod.id}"
                data-kind="slide"
                value="${escapeAttr(paths[mod.id].slide)}"
                class="w-full px-3 py-2 rounded-xl text-xs bg-white border border-slate-300 focus:border-emerald-600 focus:outline-none font-mono"
              />
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-amber-800 mb-1">
                Đường dẫn / tên file Lab
              </label>
              <input
                type="text"
                data-module-id="${mod.id}"
                data-kind="lab"
                value="${escapeAttr(paths[mod.id].lab)}"
                class="w-full px-3 py-2 rounded-xl text-xs bg-white border border-slate-300 focus:border-amber-600 focus:outline-none font-mono"
              />
            </div>
          </div>
        </div>
      `).join("");

      openModal("configModal");
    }

    function saveFilePaths() {
      const inputs = document.querySelectorAll("#configInputs input[data-module-id]");
      const next = {};
      for (const mod of COURSE_MODULES) {
        next[mod.id] = { slide: mod.defaultSlideFile, lab: mod.defaultLabFile };
      }
      inputs.forEach((inp) => {
        const id = Number(inp.getAttribute("data-module-id"));
        const kind = inp.getAttribute("data-kind");
        if (next[id] && (kind === "slide" || kind === "lab")) {
          next[id][kind] = inp.value.trim();
        }
      });

      try {
        localStorage.setItem(PATH_STORAGE_KEY, JSON.stringify(next));
      } catch (e) {
        // Bỏ qua nếu trình duyệt chặn lưu trữ
      }

      closeModal("configModal");
      showToast("Đã lưu đường dẫn file Slide & Lab.");

      const drawer = document.getElementById("drawerModal");
      if (drawer && !drawer.classList.contains("hidden")) {
        openModuleDrawer(currentDrawerMode);
      }
      const detail = document.getElementById("detailModal");
      if (detail && !detail.classList.contains("hidden")) {
        renderDetailTabContent();
      }
    }

    function resetFilePaths() {
      try {
        localStorage.removeItem(PATH_STORAGE_KEY);
      } catch (e) {
        // Bỏ qua nếu trình duyệt chặn lưu trữ
      }
      openPathConfigModal();
      showToast("Đã khôi phục tên file mặc định.");
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        ["detailModal", "configModal", "drawerModal", "referencesModal"].forEach((id) => closeModal(id));
      }
    });

    ["drawerModal", "detailModal", "referencesModal", "configModal"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener("click", (e) => {
          if (e.target === el) closeModal(id);
        });
      }
    });

    function escapeHtml(str) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function escapeAttr(str) {
      return escapeHtml(str);
    }

    window.addEventListener("DOMContentLoaded", () => {
      updateLabProgressUI();
      renderTopicsGrid();
    });
  </script>
</body>
</html>
