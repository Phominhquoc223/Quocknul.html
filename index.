     */
    function openLabWorkspaceModal(initialLabId = 0) {
      const completed = getCompletedLabs();
      if (initialLabId && COURSE_MODULES.some((m) => m.id === initialLabId)) {
        activeLabId = initialLabId;
      } else {
        const firstIncomplete = COURSE_MODULES.find((m) => !completed.includes(m.id));
        activeLabId = firstIncomplete ? firstIncomplete.id : 1;
      }
      renderLabWorkspace(activeLabId);
      openModal("labWorkspaceModal");
    }

